# Dependencies
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Environment
.env
.env.local
CLAUDE.local.md

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Data never enters git. One shared data/ lives in the main checkout; worktrees
# symlink to it, so the pattern has no trailing slash (it must match the link too).
/data
*.csv
*.parquet
!data_engineering/dbt/seeds/*.csv

# EDA: dashboard data is regenerated locally; summary tables are committed
eda/reports/dashboards/data/
!eda/reports/tables/*.csv
# Verification evidence: relation/column names, counts and verdicts only (docs/platform/evidence/*/README.md)
!docs/platform/evidence/*/*.csv
*.duckdb

# ML artifacts
ml/experiments/notebooks/.ipynb_checkpoints/
mlruns/
*.onnx
*.pt
*.pth
*.h5
*.pkl
*.joblib
!ml/serving/models/.gitkeep

# Monitoring
monitoring/grafana/data/
monitoring/prometheus/data/

# Logs
*.log
logs/
airflow_logs/

# Coverage
htmlcov/
.coverage
coverage.xml

# Secrets
# NOTE: .secrets.baseline is intentionally COMMITTED — it is the shared
# detect-secrets audit baseline, not a secret itself.
*.pem
*.key

# Terraform
infrastructure/terraform/.terraform/
infrastructure/terraform/*.tfstate
infrastructure/terraform/*.tfstate.backup
infrastructure/terraform/.terraform.lock.hcl

# dbt
data_engineering/dbt/target/
data_engineering/dbt/logs/
data_engineering/dbt/dbt_packages/

# Misc
*.bak
*.tmp
scratch/

# dbt (platform/dbt)
platform/dbt/target/
platform/dbt/target-airflow/
platform/dbt/logs/
platform/dbt/dbt_packages/
platform/dbt/.user.yml
!platform/dbt/seeds/*.csv

# Local platform stack secrets (generated by bootstrap_env.py)
platform/docker/.env
