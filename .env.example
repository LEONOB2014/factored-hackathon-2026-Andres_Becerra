# ==============================================================================
# Environment Configuration
# Copy to .env and fill in your values
# ==============================================================================

# === LLM API Keys ===
OPENAI_API_KEY=sk-your-key-here
GOOGLE_API_KEY=your-google-api-key
ANTHROPIC_API_KEY=your-anthropic-key

# === Database ===
DATABASE_URL=postgresql+asyncpg://factored:factored2026@localhost:5432/bankingdb
POSTGRES_USER=factored
POSTGRES_PASSWORD=factored2026
POSTGRES_DB=bankingdb

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Neo4j ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=factored2026

# === MLflow ===
MLFLOW_TRACKING_URI=http://localhost:5000

# === Airflow ===
AIRFLOW_FERNET_KEY=your-fernet-key-here

# === GCP (for cloud deployment) ===
GCP_PROJECT_ID=factored-hackathon-2026
GCP_REGION=us-central1
GCS_BUCKET=factored-hackathon-2026-data

# === Application ===
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# Dataset download (eda/scripts/download_s3.py)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
S3_BUCKET=

# === Copilot: a hosted OpenAI-compatible model instead of Claude (for example Featherless) ===
# COPILOT_LLM_BACKEND=openai
# COPILOT_LLM_BASE_URL=https://api.featherless.ai/v1
# COPILOT_LLM_API_KEY=
# COPILOT_LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
# COPILOT_LLM_PRICE_IN=      # USD per million input tokens, for the cost report
# COPILOT_LLM_PRICE_OUT=     # USD per million output tokens
